(set-logic ALL)
(declare-sort Req 0)
(declare-sort Val 0)
(declare-fun a (Req) Val)
(declare-const k Val)
(declare-fun code (Val) Int)
(assert (forall ((u Val) (v Val)) (=> (= (code u) (code v)) (= u v))))
(assert (exists ((x Req)) (not (= (not (= (a x) k)) (not (= (code (a x)) (code k)))))))
(check-sat)
