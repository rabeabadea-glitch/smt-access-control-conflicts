(set-logic ALL)
(declare-sort Req 0)
(declare-fun A (Req) Bool)
(declare-fun B (Req) Bool)
(declare-fun Ap (Req) Bool)
(declare-fun Bp (Req) Bool)
(assert (forall ((x Req)) (not (and (A x) (B x)))))
(assert (forall ((x Req)) (=> (Ap x) (A x))))
(assert (forall ((x Req)) (=> (Bp x) (B x))))
(assert (exists ((x Req)) (and (Ap x) (Bp x))))
(check-sat)
