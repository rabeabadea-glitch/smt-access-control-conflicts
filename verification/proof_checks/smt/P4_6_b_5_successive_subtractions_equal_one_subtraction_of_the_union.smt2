(set-logic ALL)
(declare-sort Req 0)
(declare-fun L (Req) Bool)
(declare-fun W0 (Req) Bool)
(declare-fun W1 (Req) Bool)
(declare-fun W2 (Req) Bool)
(declare-fun W3 (Req) Bool)
(declare-fun W4 (Req) Bool)
(define-fun S0 ((x Req)) Bool (and (L x) (not (W0 x))))
(define-fun S1 ((x Req)) Bool (and (S0 x) (not (W1 x))))
(define-fun S2 ((x Req)) Bool (and (S1 x) (not (W2 x))))
(define-fun S3 ((x Req)) Bool (and (S2 x) (not (W3 x))))
(define-fun S4 ((x Req)) Bool (and (S3 x) (not (W4 x))))
(assert (exists ((x Req)) (not (= (S4 x) (and (L x) (not (or (W0 x) (W1 x) (W2 x) (W3 x) (W4 x))))))))
(check-sat)
