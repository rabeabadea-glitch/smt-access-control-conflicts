{
  "precedence": [
    {
      "higher": "AMLD",
      "lower": "GDPR",
      "basis": "F1 GDPR Art. 17(3)(b) legal-obligation exception; F4 GDPR Art. 23(1)(e) restriction"
    },
    {
      "higher": "AMLD",
      "lower": "PCI_DSS",
      "basis": "F5 PCI DSS Req 3.3 legitimate-business-need exception covers investigators"
    },
    {
      "higher": "PCI_DSS",
      "lower": "GDPR",
      "basis": "F3 documented resolution path: PCI Req 10 logging is a documented purpose"
    },
    {
      "higher": "SOX",
      "lower": "GDPR",
      "basis": "F6 by analogy with F1: statutory retention limits erasure/purge (researcher assumption; no governed variant in corpus)"
    },
    {
      "higher": "DORA",
      "lower": "GDPR",
      "basis": "F7 GDPR Art. 6(1)(c) legal-obligation basis for incident reporting"
    }
  ],
  "requirements": [
    {
      "id": "F1-retain-transaction-records",
      "required": "Deny",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "action",
            "value": "erase"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "transaction-record"
          },
          {
            "op": "lt",
            "attr": "retention_age_years",
            "value": 5
          }
        ]
      },
      "basis": "AMLD Art. 40(1)"
    },
    {
      "id": "F1-erase-after-retention",
      "required": "Permit",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "action",
            "value": "erase"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "transaction-record"
          },
          {
            "op": "eq",
            "attr": "contains_pii",
            "value": "true"
          },
          {
            "op": "ge",
            "attr": "retention_age_years",
            "value": 5
          }
        ]
      },
      "basis": "GDPR Art. 17(1) outside the retention period"
    },
    {
      "id": "F4-no-tipping-off",
      "required": "Deny",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "role",
            "value": "data-subject"
          },
          {
            "op": "eq",
            "attr": "action",
            "value": "read"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "customer-file"
          },
          {
            "op": "eq",
            "attr": "str_flag",
            "value": "true"
          }
        ]
      },
      "basis": "AMLD Art. 39(1)"
    },
    {
      "id": "F4-subject-access",
      "required": "Permit",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "role",
            "value": "data-subject"
          },
          {
            "op": "eq",
            "attr": "action",
            "value": "read"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "customer-file"
          },
          {
            "op": "eq",
            "attr": "contains_pii",
            "value": "true"
          },
          {
            "op": "eq",
            "attr": "str_flag",
            "value": "false"
          }
        ]
      },
      "basis": "GDPR Art. 15(1) when no STR is filed"
    },
    {
      "id": "F5-investigator-full-pan",
      "required": "Permit",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "role",
            "value": "investigator"
          },
          {
            "op": "eq",
            "attr": "action",
            "value": "display-full-pan"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "cardholder-data"
          }
        ]
      },
      "basis": "PCI DSS Req 3.3 legitimate-need exception"
    },
    {
      "id": "F3-log-chd-access",
      "required": "Permit",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "action",
            "value": "log"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "chd-access-event"
          }
        ]
      },
      "basis": "PCI DSS Req 10.2"
    },
    {
      "id": "F6-retain-audit-workpapers",
      "required": "Deny",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "action",
            "value": "purge"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "audit-workpaper"
          },
          {
            "op": "lt",
            "attr": "retention_age_years",
            "value": 7
          }
        ]
      },
      "basis": "SOX s.802"
    },
    {
      "id": "F7-report-incident",
      "required": "Permit",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "action",
            "value": "transmit"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "incident-report"
          }
        ]
      },
      "basis": "DORA Art. 19(1)"
    },
    {
      "id": "INT-guest-no-config-write",
      "required": "Deny",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "attr": "role",
            "value": "guest"
          },
          {
            "op": "eq",
            "attr": "action",
            "value": "write"
          },
          {
            "op": "eq",
            "attr": "record_type",
            "value": "system-config"
          }
        ]
      },
      "basis": "internal benign control"
    }
  ],
  "scenario_B_removed_rules": [
    "NIST-63B-no-forced-rotation",
    "PCI-8-3-9-rotate-password"
  ],
  "note": "Written for this case study from docs/regulatory_mapping.md; not legal advice; not an approval."
}