{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pcproof/cpm-1.schema.json",
  "title": "CPM-1 research policy",
  "description": "Structural schema. pcproof.model.normalize also enforces attribute types, domains, references, unique IDs, limits and acyclic precedence.",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1000
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge"
              ]
            },
            "attr": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          },
          "required": [
            "op",
            "attr",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "domain": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bool"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "int"
            },
            "min": {
              "type": "integer",
              "minimum": -9007199254740992,
              "maximum": 9007199254740992
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740992,
              "maximum": 9007199254740992
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cpm-1"
    },
    "attributes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/domain"
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "regulation",
              "standard",
              "internal",
              "synthetic"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "mapping_status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "citation",
          "mapping_status"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "Permit",
              "Deny"
            ]
          },
          "condition": {
            "$ref": "#/$defs/expression"
          },
          "provenance": {}
        },
        "required": [
          "id",
          "source",
          "effect",
          "condition"
        ],
        "additionalProperties": false
      }
    },
    "validity": {
      "$ref": "#/$defs/expression"
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "higher": {
            "type": "string",
            "minLength": 1
          },
          "lower": {
            "type": "string",
            "minLength": 1
          },
          "approval_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "higher",
          "lower",
          "approval_id"
        ],
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "$ref": "#/$defs/expression"
          },
          "required": {
            "enum": [
              "Permit",
              "Deny"
            ]
          }
        },
        "required": [
          "id",
          "when",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "attributes",
    "sources",
    "rules"
  ],
  "additionalProperties": false
}
